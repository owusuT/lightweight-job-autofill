{
  "manifest_version": 3,
  "name": "jolly R — AI Job Autofill",
  "version": "2.0.0",
  "description": "jolly R is your AI job search assistant. It detects job application forms, fills them instantly, and tracks every application you submit.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting",
    "alarms",
    "cookies"
  ],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contentScript.js"],
      "css": ["contentScript.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.jolly-r.app/*"],
      "js": ["injectScriptHandler.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "jolly R"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "contentScript.css",
        "injectScript.js",
        "lib/pdfjs/build/pdf.js",
        "lib/pdfjs/build/pdf.worker.js"
      ],
      "matches": ["*://*/*"]
    }
  ]
}
